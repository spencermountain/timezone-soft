{
  "name": "timezone-soft",
  "version": "1.7.0",
  "description": "informal timezone lookup",
  "license": "MIT",
  "repository": "github:spencermountain/timezone-soft",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/timezone-soft.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/timezone-soft.cjs"
      },
      "default": {
        "types": "./types/index.d.cts",
        "default": "./builds/timezone-soft.cjs"
      }
    }
  },
  "main": "./builds/timezone-soft.cjs",
  "module": "./builds/timezone-soft.js",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "build:data": "pnpm run validate:data && node ./scripts/build/01-pack.js",
    "build": "pnpm run build:data && node ./scripts/build/02-version.js && rollup -c && pnpm run filesize",
    "filesize": "node ./scripts/build/03-filesize.js",
    "test": "TESTENV=dev node --harmony-temporal ./node_modules/tape/bin/tape './test/**/*.test.js' | tap-dancer",
    "testb": "TESTENV=prod node --harmony-temporal ./node_modules/tape/bin/tape './test/**/*.test.js' | tap-dancer",
    "lint": "eslint .",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.bundler.json",
    "test:dist": "node test/check/dist.js",
    "check": "pnpm run lint && pnpm run build && pnpm test && pnpm run testb && pnpm run test:dist && pnpm run test:types && pnpm run test:package",
    "validate:data": "node test/check/data.js",
    "test:package": "node test/check/package.js",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check",
    "upkeep:cities": "node scripts/cities/test.js",
    "upkeep": "node scripts/upkeep/zones.js",
    "upkeep:overlap": "node scripts/upkeep/overlap.js"
  },
  "files": [
    "builds",
    "types"
  ],
  "keywords": [
    "timezone",
    "iana",
    "dst"
  ],
  "dependencies": {
    "efrt": "2.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.11.0",
    "rollup": "4.63.5",
    "rollup-plugin-filesize-check": "^2.0.1",
    "spacetime": "7.15.0",
    "tap-dancer": "0.4.3",
    "tape": "5.10.2",
    "typescript": "^7.0.2"
  },
  "unpkg": "builds/timezone-soft.min.js",
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
