{
  "name": "timezone-soft",
  "version": "1.5.2",
  "author": "spencermountain",
  "description": "interpret abbreviated and informal timezone names",
  "main": "builds/timezone-soft.cjs",
  "module": "builds/timezone-soft.mjs",
  "unpkg": "builds/timezone-soft.min.cjs",
  "types": "types/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/timezone-soft.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/timezone-soft.cjs"
      },
      "default": "./builds/timezone-soft.cjs"
    }
  },
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "pack": "node ./scripts/pack.js",
    "build": "npm run pack && node ./scripts/version.js && rollup -c && npm run filesize",
    "filesize": "node ./scripts/filesize.js",
    "test": "TESTENV=dev tape ./test/**/*.test.js | tap-dancer",
    "testb": "TESTENV=prod tape ./test/**/*.test.js | tap-dancer",
    "lint": "eslint .",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.bundler.json",
    "test:dist": "node scripts/test-dist.js",
    "check": "npm run lint && npm run build && npm test && npm run testb && npm run test:dist && npm run test:types && npm run test:package",
    "validate:data": "node scripts/validate-data.js",
    "test:package": "node scripts/test-package.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/timezone-soft.git"
  },
  "bugs": {
    "url": "https://github.com/spencermountain/timezone-soft/issues"
  },
  "homepage": "https://github.com/spencermountain/timezone-soft#readme",
  "files": [
    "builds",
    "types"
  ],
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "dependencies": {
    "efrt": "2.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.11.0",
    "rollup": "4.63.4",
    "spacetime": "7.15.0",
    "tap-dancer": "0.4.0",
    "tape": "5.10.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
